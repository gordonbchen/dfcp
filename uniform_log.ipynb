   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "d_min = 0.01\n",
    "logd = np.linspace(np.log(d_min), 0, 1000)\n",
    "d = np.exp(logd)\n",
    "plt.plot(logd, d)\n",
    "plt.show()\n",
    "\n",
    "plt.hist(d, bins=50);"
   ]
  }
